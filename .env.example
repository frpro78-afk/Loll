# Copy this file to .env and adjust values. Never commit .env.

APP_NAME=MahaQuant
ENVIRONMENT=development

# Public spot market data source (no API key required).
# If api.binance.com is blocked in your region, use https://api.binance.us instead.
MARKET_DATA_BASE_URL=https://api.binance.com
MARKET_DATA_TIMEOUT_SECONDS=5

# Paper trading (simulated money only)
PAPER_STARTING_BALANCE=10000
PAPER_QUOTE_ASSET=USDT

# --- Phase 2: risk management (all percentages) ---
# Percent of equity lost if the stop-loss is hit.
RISK_PER_TRADE_PCT=1
RISK_STOP_LOSS_PCT=2
RISK_TAKE_PROFIT_PCT=4
# Largest single position as a percent of equity.
RISK_MAX_POSITION_PCT=25
RISK_MAX_OPEN_POSITIONS=3
# Orders smaller than this (in quote currency) are rejected.
RISK_MIN_ORDER_NOTIONAL=10

# --- Phase 2: strategy engine eligibility ---
ENGINE_MIN_CONFIDENCE=0.55
ENGINE_MIN_BACKTEST_TRADES=3
ENGINE_MIN_BACKTEST_RETURN_PCT=0
ENGINE_MAX_BACKTEST_DRAWDOWN_PCT=20

# Fee per side used in backtests, in percent.
BACKTEST_FEE_PCT=0.1
