# Copy this file to .env and adjust values. Never commit .env.

APP_NAME=MahaQuant
ENVIRONMENT=development

# Public spot market data source (no API key required).
# If api.binance.com is blocked in your region, use https://api.binance.us instead.
MARKET_DATA_BASE_URL=https://api.binance.com
MARKET_DATA_TIMEOUT_SECONDS=5

# Paper trading (simulated money only)
PAPER_STARTING_BALANCE=10000
PAPER_QUOTE_ASSET=USDT
